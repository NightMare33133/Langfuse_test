# Dify 应用 API（批量提问用，app- 开头的 Key）
# 仅用于 /chat-messages 等应用接口
DIFY_APP_API_KEY=
DIFY_APP_API_BASE=http://localhost/v1

# Dify 知识库 API（知识库探索用，dataset- 开头的 Key）
# 仅用于 /datasets、/documents、/segments 等只读知识库接口
DIFY_DATASET_API_KEY=
DIFY_DATASET_API_BASE=http://localhost/v1

# 向后兼容：旧版 DIFY_API_KEY / DIFY_API_BASE 仍可作为应用 API 的 fallback
# DIFY_API_KEY=
# DIFY_API_BASE=http://localhost/v1

JUDGE_API_KEY=
JUDGE_API_BASE=https://token-plan-cn.xiaomimimo.com/v1
JUDGE_MODEL=mimo-v2.5-pro

# 题目生成（可选，默认复用 Judge 配置）
QGEN_API_KEY=
QGEN_API_BASE=
QGEN_MODEL=

# AI 优化分析（可选，默认复用 Judge 配置）
# ANALYSIS_API_KEY=
# ANALYSIS_API_BASE=
# ANALYSIS_MODEL=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
